NODE_ENV=production
PORT=3000
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_USER=psyagent_user
DB_PASSWORD=replace-with-a-unique-strong-database-password
DB_NAME=psych_diagnostic
CONTROL_DB_NAME=psych_control

JWT_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=replace-with-at-least-12-random-characters

# Используются только при ручной команде npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_FULL_NAME=Администратор-психолог
ADMIN_EMAIL=

# Максимальный размер JSON-запроса Express
JSON_BODY_LIMIT=5mb
