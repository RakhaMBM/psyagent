NODE_ENV=production
PORT=3000
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_USER=psyagent_user
DB_PASSWORD=replace-with-a-unique-strong-database-password
DB_NAME=psych_diagnostic
CONTROL_DB_NAME=psych_control
TENANT_DB_PREFIX=psych_t_

JWT_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=replace-with-at-least-12-random-characters

# Если задан, используется для новых студентов без явно указанного пароля
# и командой npm run reset-student-passwords для массового сброса.
DEFAULT_STUDENT_PASSWORD=

# Используются только при ручной команде npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_FULL_NAME=Администратор-психолог
ADMIN_EMAIL=

# Максимальный размер JSON-запроса Express
JSON_BODY_LIMIT=5mb

# ИИ-анализ результатов через Open Web UI (OpenAI-совместимый API).
# Если переменные не заданы — функция отключена, кнопки в интерфейсе скрыты.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=
# Таймаут ответа модели в миллисекундах (по умолчанию 120000)
OPENWEBUI_TIMEOUT_MS=120000
